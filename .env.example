# ── LLM Provider ────────────────────────────────────────────────────────────
# Set LLM_PROVIDER to "openai" or "anthropic".
# Only the matching API key is required.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here    # optional

# ── Tool Keys (all optional — sensible fallbacks exist) ─────────────────────
TAVILY_API_KEY=your_tavily_api_key_here           # better web search; falls back to DuckDuckGo
PINECONE_API_KEY=your_pinecone_api_key_here       # cloud vector DB; falls back to ChromaDB

# ── Vector Store ─────────────────────────────────────────────────────────────
VECTOR_BACKEND=chroma     # "chroma" (local, no setup) or "pinecone" (cloud)
PINECONE_INDEX=research-context

# ── Agent Loop ───────────────────────────────────────────────────────────────
MAX_STEPS=12              # max agent steps per run (1–50)
RUN_TIMEOUT_SECONDS=600   # hard timeout per run in seconds

# ── Storage ──────────────────────────────────────────────────────────────────
RUNS_DIR=./runs           # where run artefacts (reports, chroma DBs) are stored

# ── API Server ───────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:8501   # comma-separated CORS origins
# INTERNAL_API_KEY=change_me            # uncomment to require X-API-Key header
RATE_LIMIT_PER_MINUTE=10               # max research starts per IP per minute
QUEUE_TTL_SECONDS=300                  # seconds to keep finished run queues in memory

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false            # set "true" in Docker/production for structured logs

# ── Redis (required for run lifecycle management) ────────────────────────
REDIS_URL=redis://localhost:6379        # local dev; docker-compose overrides to redis://redis:6379

# ── UI ───────────────────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:8000   # where the Streamlit UI connects to the API

# ── Vercel public prompt UI ──────────────────────────────────────────────────
# OPENAI_API_KEY must be configured in Vercel Project Settings, not in browser code.
# OPENAI_MODEL can override LLM_MODEL for the public /api/chat endpoint.
OPENAI_MODEL=gpt-4o-mini
# Optional: require visitors to enter this access code before the public endpoint calls OpenAI.
# SITE_ACCESS_TOKEN=change_me
SITE_RATE_LIMIT_PER_MINUTE=6
# Optional: comma-separated production origins if you add a custom domain.
# PUBLIC_SITE_ORIGIN=https://autonomous-ai-researcher.vercel.app
