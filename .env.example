# ── LLM Provider ────────────────────────────────────────────────────────────
# Set LLM_PROVIDER to "openai", "anthropic", or "openrouter".
# OpenRouter is the default provider for this project.
# Only the matching API key is required.
# Model IDs are provider-specific: use the bare ID for "anthropic"
# (claude-sonnet-5), and the prefixed form for "openrouter"
# (anthropic/claude-sonnet-5). A prefixed ID sent to the Anthropic API 404s.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
OPENROUTER_SITE_URL=https://zhaobangz.github.io/Autonomous-AI-Researcher/
OPENROUTER_APP_NAME=Autonomous AI Researcher        # optional alternate provider
ANTHROPIC_API_KEY=  # optional

# ── Tool Keys (all optional — sensible fallbacks exist) ─────────────────────
TAVILY_API_KEY=your_tavily_api_key_here           # better web search; falls back to DuckDuckGo
PINECONE_API_KEY=your_pinecone_api_key_here       # cloud vector DB; falls back to ChromaDB

# ── Vector Store ─────────────────────────────────────────────────────────────
VECTOR_BACKEND=chroma     # "chroma" (local, no setup) or "pinecone" (cloud)
PINECONE_INDEX=research-context

# ── Agent Loop ───────────────────────────────────────────────────────────────
MAX_STEPS=12              # max agent steps per run (1–50)
RUN_TIMEOUT_SECONDS=600   # hard timeout per run in seconds

# ── Storage ──────────────────────────────────────────────────────────────────
RUNS_DIR=./runs           # where run artefacts (reports, chroma DBs) are stored

# ── API Server ───────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:8501   # comma-separated explicit origins; wildcards are rejected
# INTERNAL_API_KEY=replace_with_32_plus_random_chars  # require X-API-Key on REST + WebSocket API routes
RATE_LIMIT_PER_MINUTE=10               # max research starts per IP per minute
QUEUE_TTL_SECONDS=300                  # seconds to keep finished run queues in memory

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false            # set "true" in Docker/production for structured logs

# ── Redis (required for run lifecycle management) ────────────────────────
REDIS_URL=redis://localhost:6379        # local dev; docker-compose overrides to redis://redis:6379

# ── UI ───────────────────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:8000   # where the Streamlit UI connects to the API

# ── Optional hosted prompt API ───────────────────────────────────────────────
# GitHub Pages is static and cannot store API keys or run /api/chat.
# To enable the public prompt form on GitHub Pages, deploy a separate HTTPS API
# and set assets/js/config.js -> window.AIR_SITE_CONFIG.chatEndpoint to that URL.
#
# These values are for that separate API process only. Do not put secrets in
# browser JavaScript or GitHub Pages files.
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_MODEL=openai/gpt-4o-mini
SITE_RATE_LIMIT_PER_MINUTE=6
# Optional: comma-separated production origins if your API enforces CORS.
# Use origins only: scheme + host + optional port, with no path.
# PUBLIC_SITE_ORIGIN=https://zhaobangz.github.io
